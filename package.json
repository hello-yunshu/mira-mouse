{
  "name": "@mira/app",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "assets:windows-installer": "python3 scripts/generate-windows-installer-assets.py",
    "assets:macos-dark-icon": "bash scripts/generate-macos-dark-icon.sh",
    "sidecar:build": "cargo run --package xtask -- dist-sidecar",
    "build:dmg": "TAURI_BUNDLER_DMG_IGNORE_CI=1 npm exec tauri build -- --bundles app,dmg",
    "build:test-app": "node scripts/build-test-app.mjs",
    "smoke:test-app": "bash scripts/smoke-test-built-app.sh",
    "version:print": "node scripts/app-version.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "sync:version:check": "node scripts/sync-version.mjs --check",
    "check:version-bump": "node scripts/check-local-ai-version-bump.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint .",
    "prepare": "simple-git-hooks || true",
    "check:quick": "bash scripts/quick-check.sh",
    "check:ci": "bash scripts/local-ci.sh",
    "check:plugin-contract": "node scripts/check-bundled-plugin-contract.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:structured": "node scripts/check-structured.mjs && node scripts/check-version-sources.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.5.0",
    "i18next": "^26.3.6",
    "react": "19.2.8",
    "thinking-orbs": "git+https://github.com/hello-yunshu/thinking-orbs.git",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "simple-git-hooks": {
    "pre-push": "[ \"${MIRA_SKIP_HOOKS:-}\" = 1 ] && exit 0 || npm run check:quick"
  }
}
